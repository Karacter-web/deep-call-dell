# Karacter Hub | Deep Call Live — environment template
# Copy to .env and fill in your keys:  cp .env.example .env

# ---- Frontend ---------------------------------------------------------------
# Socket.io URL of the FastAPI backend. Leave unset to run the mock stream.
VITE_BACKEND_WS_URL=http://localhost:8000

# ---- Backend: general -------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
# Public https URL Twilio can reach (e.g. an ngrok tunnel or your domain)
PUBLIC_BASE_URL=https://your-domain.example.com

# ---- Speech to text ---------------------------------------------------------
STT_PROVIDER=whisper           # whisper | google
WHISPER_MODEL=base             # tiny | base | small | medium | large
# GOOGLE_STT_CREDENTIALS=/secrets/google.json

# ---- Translation ------------------------------------------------------------
TRANSLATION_PROVIDER=deepl     # deepl | google
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
DEFAULT_TARGET_LANG=es

# ---- Text to speech ---------------------------------------------------------
TTS_PROVIDER=elevenlabs        # elevenlabs | google
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ---- Twilio -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550000000
